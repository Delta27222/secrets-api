#!/bin/sh
# Busca python3 primero, luego python
if command -v python3 >/dev/null 2>&1; then
    PYTHON_CMD=python3
elif command -v python >/dev/null 2>&1; then
    PYTHON_CMD=python
else
    echo "Error: Python no encontrado. Instala Python 3 primero." >&2
    exit 1
fi

$PYTHON_CMD -m tek_secrets.main "$@"